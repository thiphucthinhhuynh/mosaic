generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// id is a UUID, not an autoincrementing integer: this row is reachable via a
// public endpoint (GET /api/v1/users/:id), and sequential integer IDs would
// let anyone enumerate every user by walking 1, 2, 3, ... — see
// docs/architecture.md §19.
//
// username/email uniqueness is case-sensitive (Postgres default collation).
// "JohnDoe" and "johndoe" are currently allowed to coexist as distinct
// accounts — a known limitation tracked for Milestone 2, when signup makes
// this collision reachable for the first time. See docs/roadmap.md.
model User {
  id           String   @id @default(uuid())
  username     String   @unique @db.VarChar(30)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  profilePic   String?  @map("profile_pic")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  stores       Store[]

  @@map("users")
}

// onDelete: Cascade — deleting a user deletes their stores too. There's no
// account-deletion feature yet, so this is currently unreachable, but it's a
// deliberate choice (not the unspecified default) for when one exists:
// orphaned stores with no owner aren't a state this app wants to support.
//
// @@index([ownerId]): Postgres does not automatically index a foreign-key
// column, and GET /api/v1/users/me/stores (Milestone 3, step 5) will query
// on exactly this column.
model Store {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  name        String   @db.VarChar(100)
  description String?  @db.Text
  location    String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items Item[]

  @@index([ownerId])
  @@map("stores")
}

// No direct ownerId: Milestone 4's DoD requires ownership to be derived
// through the store relation (item.store.ownerId), not a shortcut column —
// this is the second real use of requireOwnership's resource-loader
// pattern, one hop deeper than Store's.
//
// onDelete: Cascade on storeId — deleting a store deletes its items (and,
// transitively, their images), same reasoning as User -> Store above.
//
// category is required, not optional like description/location: unlike
// those, Milestone 5's search/filtering depends on every item having one to
// filter by, so leaving it out isn't a case this schema wants to allow.
//
// price/quantity have no DB-level CHECK constraint — negative values are
// rejected by the Zod schema at the API boundary (Milestone 4 step 3), the
// same layer that already owns every other value-range rule in this app.
//
// @@index([storeId]): Postgres does not auto-index FK columns, and
// GET /api/v1/stores/:storeId/items (Milestone 4, step 2) queries on it.
model Item {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  name        String   @db.VarChar(100)
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
  category    String   @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store  Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  images ItemImage[]

  @@index([storeId])
  @@map("items")
}

// No updatedAt: images aren't edited in place, only added/removed, so
// there's nothing on this row that changes after creation.
//
// @@index([itemId]): same FK-indexing reasoning as Item.storeId above.
model ItemImage {
  id        String   @id @default(uuid())
  itemId    String   @map("item_id")
  url       String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_images")
}
