# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables — ignore every real .env variant, but keep the
# committed .example templates (including per-environment ones like
# .env.test.example) so onboarding docs and CI both work off real files.
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*

# Editor/OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Testing / coverage
coverage/

# TypeScript build info
*.tsbuildinfo

# Prisma (generated client output, once Milestone 1 introduces it)
apps/api/src/generated/
